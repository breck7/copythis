buildZipParser
 description Zip the listed files or folders after preceding build commands. Requires the zip command.
 extends abstractBuildCommandParser
 cueFromId
 javascript
  async buildTwo() {
   const { folderPath, fileSystem, path, Disk } = this.root
   const [name, ...patterns] = this.getAtomsFrom(1)
   if (!name || !patterns.length)
    throw new Error("buildZip requires an output name and at least one file or wildcard pattern")
   if (typeof path.matchesGlob !== "function")
    throw new Error("buildZip wildcards require Node 20.17 or newer")
   const archivePath = path.resolve(folderPath, name)
   const candidates = Disk.getRecursive(folderPath)
    .map(file => path.relative(folderPath, file).split(path.sep).join("/"))
    .filter(file => !file.startsWith(".git/") && !file.startsWith("node_modules/") && !file.includes("/node_modules/") && path.resolve(folderPath, file) !== archivePath)
    .sort()
   const hasWildcard = pattern => /[*?[\]]/.test(pattern)
   const unmatched = []
   const files = patterns.flatMap(pattern => {
    if (!hasWildcard(pattern)) {
     if (!Disk.exists(path.resolve(folderPath, pattern))) unmatched.push(pattern)
     return [pattern]
    }
    const matches = candidates.filter(file => path.matchesGlob(file, pattern))
    if (!matches.length) unmatched.push(pattern)
    return matches
   })
   if (unmatched.length)
    throw new Error(`buildZip matched no files for: ${unmatched.join(", ")}`)
   const uniqueFiles = [...new Set(files)]
   const zip = require("child_process").execFileSync("zip", ["-rq", "-", ...uniqueFiles], { cwd: folderPath, maxBuffer: 100 * 1024 * 1024 })
   await fileSystem.writeProduct(path.join(folderPath, name), zip)
  }

